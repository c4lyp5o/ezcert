NODE_ENV = # development | production (production requires all JWT secrets below)

PORT = # API port, default 5000

JWT_SECRET = # signs tenant session tokens (7d)
SUPER_JWT_SECRET = # signs superadmin session tokens (1h)
MAGIC_JWT_SECRET = # signs activation-link tokens (1h)

POSTGRES_URL = # e.g. postgres://user:pass@localhost:5432/ezcert
DB_SSL = # verify (default in production) | no-verify (self-signed) | disable (dev only)
DB_ALLOW_INSECURE = # set true ONLY if the DB is on a private network and can't do TLS (production otherwise refuses)

DATA_ENCRYPTION_KEY = # REQUIRED. 32 random bytes, base64. Encrypts participant name/email/IC. BACK IT UP: losing it = losing that data.
                      # generate: bun -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
TRUST_PROXY = # true when behind nginx/a load balancer, so check-in rate limits use X-Forwarded-For

DOMAIN_NAME = # public origin, e.g. https://ezcert.example.com (activation links + CORS)

EMAIL_HOST = # SMTP host
EMAIL_PORT = # SMTP port, default 587
EMAIL_SECURE = # true for port 465, otherwise false
EMAIL_USER = # SMTP username
EMAIL_PASSWORD = # SMTP password
EMAIL_FROM = # optional sender, default "EzCert Admin" <admin@ezcert.com>

UPLOAD_DIR = # optional: where uploaded logos/backgrounds are stored, default ./uploads (mount as a volume in Docker)

LOG_LEVEL = # optional: trace | debug | info (default) | success | warn | error | fatal | silent
LOG_FILE_PATH = # optional: e.g. ./logs/app.log to also write rotating log files
