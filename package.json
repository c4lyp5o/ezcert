{
	"name": "ezcert",
	"version": "1.0.0",
	"license": "MIT",
	"scripts": {
		"install:client": "cd client && bun install",
		"install:server": "bun install",
		"install:all": "npm run install:server && npm run install:client",
		"dev:client": "cd client && bun dev",
		"dev:server": "bun --env-file .env --watch src/index.js",
		"dev": "conc -n \"CLIENT,API\" -c \"cyan,magenta\" \"npm run dev:client\" \"npm run dev:server\"",
		"build-client": "cd client && bun run build",
		"build:all": "npm run build-client",
		"start": "pm2-runtime start ecosystem.config.js --env production",
		"stop": "pm2 stop all",
		"restart": "pm2 restart all",
		"logs": "pm2 monit",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:seed-super": "bun --env-file .env tests/seed-super.ts",
		"db:encrypt-pii": "bun --env-file .env scripts/encrypt-attendees.ts",
		"test": "bun test --preload ./tests/setup.ts ./tests",
		"test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov --preload ./tests/setup.ts ./tests",
		"test:watch": "bun test --preload ./tests/setup.ts --watch ./tests",
		"typecheck": "bunx -p typescript@5.9.3 tsc --noEmit -p . && cd client && bun run check"
	},
	"dependencies": {
		"@elysiajs/cors": "^1.4.2",
		"@elysiajs/jwt": "^1.4.2",
		"deadslog": "^2.0.0",
		"drizzle-orm": "^0.45.4",
		"elysia": "^1.4.30",
		"fast-xml-parser": "^5.11.2",
		"fflate": "^0.8.3",
		"nodemailer": "^10.2.1",
		"pdfkit": "^0.20.2",
		"pg": "^8.23.1",
		"pptxgenjs": "^4.0.1",
		"qr": "^0.7.2",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.11",
		"@types/nodemailer": "^8.0.2",
		"@types/pdfkit": "^0.17.7",
		"@types/pg": "^8.23.1",
		"bun-types": "~1.3.14",
		"concurrently": "^10.0.6",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15"
	},
	"module": "src/index.js"
}
